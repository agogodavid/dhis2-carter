# Copy to .env (never commit .env)
DHIS2_IMAGE=dhis2/core:2.43.2.1
# DHIS2_IMAGE=carter/dhis2-core:2.43.2.1-carter   # after ./scripts/build-local.sh
DHIS2_PORT=8080
DB_PORT=5432
DB_NAME=dhis
DB_USERNAME=dhis
DB_PASSWORD=change-me-test-only
JAVA_MEMORY=-Xms1g -Xmx3g
# Demo DB (Sierra Leone). Default demo login is admin / district.
DHIS2_DB_DUMP_URL=https://databases.dhis2.org/sierra-leone/2.43/dhis2-db-sierra-leone.sql.gz
# Credentials CompassLink uses against this test instance (prefer a PAT)
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district
DHIS2_API_TOKEN=
COMPASS_API_TOKEN=mock-token
